# Copy this file to .env and fill values before running the app or seeder
# MongoDB connection string example (change to your DB):
DATABASE_URL="mongodb+srv://<user>:<password>@cluster0.mongodb.net/finova?retryWrites=true&w=majority"

# NextAuth secret (generate a secure random string)
NEXTAUTH_SECRET="replace_with_secure_random"

# Optional: URL where the app runs
NEXTAUTH_URL=http://localhost:3000
